ark certifies 91.6% pure gold with a BIS logo and 6-digit code. Verify authenticity using the BIS CARE mobile app\'s "Verify HUID" feature.'},{key:"Why are gold rates different in different Indian cities?",value:"City-wise differences stem from transportation costs, local demand-supply dynamics, state taxes, and jewellers' margins—the gold quality remains the same."},{key:"Is gold still a good investment in India?",value:"Yes, gold is an excellent hedge against inflation and market volatility for long-term wealth creation. Use SGBs or ETFs for better returns than physical jewellery."}]}function m(){let e=arguments.length>0&&void 0!==arguments[0]?arguments[0]:[],a=arguments.length>1&&void 0!==arguments[1]?arguments[1]:[],i=(null==a?void 0:a[0])||{},r=(0,t.TU)(Number(null==i?void 0:i.price22Cr)),l=(0,t.TU)(Number(null==i?void 0:i.price24Cr)),n=(0,t.TU)(Number(null==i?void 0:i.price18Cr)),o={__GOLD24CARET__:l?`<strong>₹${l}</strong> per 10 gram`:"-",__GOLD22CARET__:r?`<strong>₹${r}</strong> per 10 gram`:"-",__GOLD18CARET__:n?`<strong>₹${n}</strong> per 10 gram`:"-"};return null==e?void 0:e.map(e=>({...e,value:((null==e?void 0:e.value)||"").replace(/__GOLD(?:24|22|18)CARET__/g,e=>o[e]??e)}))}function y(){let e=arguments.length>0&&void 0!==arguments[0]?arguments[0]:[],a=arguments.length>1&&void 0!==arguments[1]?arguments[1]:{},i=(0,t.TU)(Number((null==a?void 0:a.price10g)/10)),r=(0,t.TU)(Number(null==a?void 0:a.price10g)),l=(0,t.TU)(Number(null==a?void 0:a.price100g)),n=(0,t.TU)(Number(null==a?void 0:a.price1kg)),o={__SILVER1G__:i?`<strong>₹${i}</strong> per gram`:"-",__SILVER10G__:r?`<strong>₹${r}</strong> per 10 grams`:"-",__SILVER100G__:l?`<strong>₹${l}</strong> per 100 grams`:"-",__SILVER1KG__:n?`<strong>₹${n}</strong> per kg`:"-"};return null==e?void 0:e.map(e=>({...e,value:((null==e?void 0:e.value)||"").replace(/__SILVER(?:1G|10G|100G|1KG)__/g,e=>o[e]??e)}))}function g(){let e=arguments.length>0&&void 0!==arguments[0]?arguments[0]:{},a=(0,t.TU)(Number(null==e?void 