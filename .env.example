# ==========================================
# Database Connection Settings
# ==========================================

# Direct connection URL for migrations and DDL (Admin role)
DIRECT_URL="postgres://admin:password@localhost:5432/kew_hazard_db"

# Connection pooling URL for API queries (Readonly API role)
DATABASE_URL="postgres://readonly_api:password@localhost:5432/kew_hazard_db"

# Connection URL for ingestion worker (Worker role)
INGESTION_DB_URL="postgres://ingestion_worker:password@localhost:5432/kew_hazard_db"

# Security keys for internal cron ingestion
CRON_SECRET="your-secure-256-bit-key"
