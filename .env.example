# ==========================================
# Database Connection Settings
# ==========================================

# Direct connection URL for migrations and DDL (Admin role)
DIRECT_URL="postgres://admin:password@localhost:5432/kew_hazard_db"

# Connection pooling URL for API queries (Readonly API role)
DATABASE_URL="postgres://readonly_api:password@localhost:5432/kew_hazard_db"

# Connection URL for ingestion worker (Worker role)
INGESTION_DB_URL="postgres://ingestion_worker:password@localhost:5432/kew_hazard_db"

# Security keys for server session signing, admin RBAC, and scheduled ingestion
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
ADMIN_PASSCODE=""
ADMIN_API_KEY=""
ADMIN_EMAILS=""
WEBINAR_ADMIN_PASSCODE=""
DISPATCH_MASTHEAD_CODE=""
DISPATCH_REVIEWER_CODE=""
INGEST_API_KEY=""
CRON_SECRET=""

# ==========================================
# Optional Geospatial Tile API Keys
# (Default fallback is 100% open public Esri & OpenStreetMap tiles - zero key required)
# ==========================================
NEXT_PUBLIC_MAPBOX_TOKEN=""
NEXT_PUBLIC_CARTO_API_KEY=""


# ==========================================
# Global Search Discovery, Webmaster & Academic Deposit (Optional)
# ==========================================
NEXT_PUBLIC_SITE_URL="https://kashmir-ecowatch.com"
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
INDEXNOW_KEY=""
YANDEX_VERIFICATION=""
BAIDU_SITE_VERIFICATION=""
ZENODO_ACCESS_TOKEN=""
ALLOW_AI_TRAINING_CRAWLERS="true"

# ==========================================
# Himalayan Dispatch Dedicated Subdomain Routing
# (Localhost always preserves /himalayan-dispatch/** unchanged)
# ==========================================
NEXT_PUBLIC_DISPATCH_HOST="dispatch.kashmir-ecowatch.com"
NEXT_PUBLIC_DISPATCH_SITE_URL="https://dispatch.kashmir-ecowatch.com"
# Set to "true" in production ONLY after https://dispatch.kashmir-ecowatch.com is verified live:
NEXT_PUBLIC_DISPATCH_SUBDOMAIN_LIVE="false"
DISPATCH_LEGACY_REDIRECTS_ENABLED="false"

# ==========================================
# KEW Virtual Scientific Hall — Self-Hosted TURN / coturn Relay (Optional)
# Uses time-limited HMAC-SHA1 ephemeral credentials (`use-auth-secret` in coturn)
# ==========================================
TURN_URL=""
TURN_SHARED_SECRET=""
TURN_CREDENTIAL_TTL_SECONDS="14400"
